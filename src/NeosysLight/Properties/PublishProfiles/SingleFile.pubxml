<?xml version="1.0" encoding="utf-8"?>
<!--
  단일 exe 배포 프로필 — 결과: D:\Source\Release\NeosysLight\NeosysLight.exe 한 파일(.NET 런타임 포함, 설치 불필요)
  Visual Studio: NeosysLight 우클릭 → 게시 → SingleFile → 게시
  명령줄:        dotnet publish src/NeosysLight -p:PublishProfile=SingleFile
  DB는 첫 실행 때 %LOCALAPPDATA%\Neosys\neosis_local.db에 자동 생성된다(스키마·공통코드가 exe 안에 포함).
  WPF는 트리밍(PublishTrimmed)을 지원하지 않으므로 켜지 않는다.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishProtocol>FileSystem</PublishProtocol>
    <PublishDir>D:\Source\Release\NeosysLight</PublishDir>
    <DeleteExistingFiles>true</DeleteExistingFiles>
    <!-- exe 하나로: .NET 런타임 포함 + 네이티브(SQLite) 라이브러리까지 exe 안에 넣고 압축 -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- 디버그 기호(pdb)는 만들지 않는다 -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>
</Project>