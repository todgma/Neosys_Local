<Window x:Class="Neosys.Local.App.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="네오시스" Background="#F9FAFB" FontWeight="Normal">
    <!-- 기존 LoginPage: 회색 바탕 가운데 폭 448 · 제목 '네오시스' · 계정에 로그인하세요 · 아이디/비밀번호 · 아이디 저장 · 로그인 · 회원가입 · 고객센터 · 카톡문의
         창 크기·위치는 메인 창과 같음(DashboardWindow.PlaceAsMain) · 내용은 세로 가운데(min-h-screen items-center)
         글자 굵기: 같은 Pretendard·같은 굵기라도 WPF는 Chromium(원본 Electron)보다 획이 약 10% 진하게 그려진다(2026-10-30 화면 캡처로 잉크 양 비교:
         제목 원본 800 = 943px, WPF ExtraBold 1058 · Bold 921). 그래서 이 창은 CSS 굵기보다 한 단계 가볍게 쓴다 — 800→Bold, 700→SemiBold, 500→Normal.
         단, 색 바탕의 흰 글자(로그인 버튼)와 파란 링크(회원가입)는 반대로 더 옅게 그려져 한 단계 무겁게 쓴다(500 → SemiBold).
         입력칸 글자: 창 폭이 640 미만이라 sm:text-sm이 적용되지 않아 body 13px(굵기 500)를 상속한다 -->
    <Window.Resources>
        <!-- 원본 입력칸: rounded-md(6px) · px-3 py-2 · border-gray-300 · 포커스 시 테두리 indigo-500 -->
        <Style TargetType="PasswordBox">
            <Setter Property="BorderBrush" Value="#D1D5DB" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="bd" Background="White" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0" Padding="{TemplateBinding Padding}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#6366F1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 안내 문구: 원본(Chromium)처럼 포커스가 있어도 글자를 입력하기 전까지 보인다 · placeholder-gray-500 -->
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B7280" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="13,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <!-- 고객센터 운영시간 한 줄: 항목(폭 68) · 10 · | · 10 · 시간 (원본 flex gap 10px, 항목 inline-block width 68px) -->
        <Style x:Key="InfoRow" TargetType="Grid">
            <Setter Property="TextElement.FontSize" Value="15" />
            <Setter Property="TextElement.FontWeight" Value="SemiBold" />
            <Setter Property="TextElement.Foreground" Value="#334155" />
        </Style>
        <!-- 원본 line-height 1.3(15px → 19.5px) -->
        <Style TargetType="TextBlock" x:Key="InfoText">
            <Setter Property="LineHeight" Value="19.5" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        </Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Border Padding="16,32,16,32" VerticalAlignment="Center">
        <StackPanel MaxWidth="448">
            <TextBlock Text="네오시스" FontSize="30" FontWeight="Bold" Foreground="#111827" HorizontalAlignment="Center" Margin="0,16,0,0" />
            <TextBlock Text="계정에 로그인하세요" FontSize="14" Foreground="#4B5563" HorizontalAlignment="Center" Margin="0,8,0,35" />

            <Grid>
                <TextBox x:Name="IdBox" Height="37" FontSize="13" FontWeight="Normal" Padding="10,0" Tag="6" BorderBrush="#D1D5DB" Foreground="#111827" TextChanged="Box_Changed" />
                <TextBlock x:Name="IdHint" Text="아이디" Style="{StaticResource Hint}" />
            </Grid>
            <Grid Margin="0,24,0,0">
                <PasswordBox x:Name="PwBox" Height="37" FontSize="13" FontWeight="Normal" Padding="10,0" Foreground="#111827" KeyDown="PwBox_KeyDown" PasswordChanged="Box_Changed" />
                <TextBlock x:Name="PwHint" Text="비밀번호" Style="{StaticResource Hint}" />
            </Grid>

            <CheckBox x:Name="RememberBox" Content="아이디 저장" Style="{StaticResource ChromeCheckBox}" FontSize="14" FontWeight="Normal" Foreground="#374151" Margin="0,26,0,0" />
            <TextBlock x:Name="MessageText" Foreground="#DC2626" FontWeight="Medium" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed" />

            <Button x:Name="LoginButton" Content="로그인" Style="{StaticResource PrimaryButton}" Height="40" FontSize="14" FontWeight="SemiBold" Margin="0,25,0,0" Click="Login_Click" IsDefault="True" />

            <TextBlock HorizontalAlignment="Center" FontSize="14" Foreground="#4B5563" Margin="0,34,0,0">
                <Run Text="계정이 없으신가요? " />
                <Hyperlink Foreground="#4F46E5" FontWeight="SemiBold" TextDecorations="{x:Null}" Click="Signup_Click">회원가입</Hyperlink>
            </TextBlock>

            <!-- 고객센터 + 카톡문의(원본 assets/chat.png 그대로 — 대시보드와 같음) -->
            <Border BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Margin="0,33,0,0" Padding="0,16,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="고객센터" FontSize="18" FontWeight="Bold" Foreground="#111827" VerticalAlignment="Bottom" Margin="0,0,12,3" />
                        <TextBlock Text="02-381-2455" FontSize="26" FontWeight="Bold" Foreground="#4F46E5" />
                    </StackPanel>
                    <Grid Style="{StaticResource InfoRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="68" /><ColumnDefinition Width="10" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="평일" Style="{StaticResource InfoText}" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="|" Foreground="#CBD5E1" Style="{StaticResource InfoText}" />
                        <TextBlock Grid.Row="0" Grid.Column="4" Text="10:00~18:00" Style="{StaticResource InfoText}" />
                        <TextBlock Grid.Row="1" Text="점심시간" Style="{StaticResource InfoText}" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="|" Foreground="#CBD5E1" Style="{StaticResource InfoText}" />
                        <TextBlock Grid.Row="1" Grid.Column="4" Text="12:00~13:30" Style="{StaticResource InfoText}" />
                        <TextBlock Grid.Row="2" Text="토요일" Style="{StaticResource InfoText}" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="|" Foreground="#CBD5E1" Style="{StaticResource InfoText}" />
                        <TextBlock Grid.Row="2" Grid.Column="4" Text="10:00~14:00" Style="{StaticResource InfoText}" />
                    </Grid>
                    <Border Height="1" Background="#E5E7EB" Margin="0,12,0,12" />
                    <Image Source="pack://application:,,,/Assets/chat.png" Stretch="Uniform" MaxWidth="440" Cursor="Hand" ToolTip="카카오톡 채팅 상담" MouseLeftButtonUp="Chat_Click" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
    </ScrollViewer>
</Window>
