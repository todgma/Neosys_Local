<Window x:Class="Neosys.Local.App.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="네오시스" Width="480" SizeToContent="Height" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" Background="#F9FAFB">
    <!-- 기존 LoginPage: 회색 바탕 가운데 폭 448 · 제목 '네오시스' · 계정에 로그인하세요 · 아이디/비밀번호 · 아이디 저장 · 로그인 · 회원가입 · 고객센터 · 카톡문의 -->
    <Border Padding="16,24,16,20">
        <StackPanel MaxWidth="448">
            <TextBlock Text="네오시스" FontSize="30" FontWeight="ExtraBold" Foreground="#111827" HorizontalAlignment="Center" Margin="0,16,0,0" />
            <TextBlock Text="계정에 로그인하세요" FontSize="14" Foreground="#4B5563" HorizontalAlignment="Center" Margin="0,8,0,28" />

            <TextBox x:Name="IdBox" Height="38" FontSize="14" BorderBrush="#D1D5DB" />
            <PasswordBox x:Name="PwBox" Height="38" FontSize="14" BorderBrush="#D1D5DB" Margin="0,12,0,0" Padding="10,3" KeyDown="PwBox_KeyDown" />

            <CheckBox x:Name="RememberBox" Content="아이디 저장" FontSize="14" Foreground="#374151" Margin="0,18,0,0" />
            <TextBlock x:Name="MessageText" Foreground="#DC2626" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed" />

            <Button x:Name="LoginButton" Content="로그인" Style="{StaticResource PrimaryButton}" Height="40" FontSize="14" FontWeight="Medium" Margin="0,22,0,0" Click="Login_Click" IsDefault="True" />

            <TextBlock HorizontalAlignment="Center" FontSize="14" Foreground="#4B5563" Margin="0,22,0,0">
                <Run Text="계정이 없으신가요? " />
                <Hyperlink Foreground="#4F46E5" FontWeight="Medium" TextDecorations="{x:Null}" Click="Signup_Click">회원가입</Hyperlink>
            </TextBlock>

            <!-- 고객센터 + 카톡문의 (대시보드와 같음) -->
            <Border BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Margin="0,18,0,0" Padding="0,16,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="고객센터" FontSize="18" FontWeight="ExtraBold" Foreground="#111827" VerticalAlignment="Bottom" Margin="0,0,12,3" />
                        <TextBlock Text="02-381-2455" FontSize="26" FontWeight="ExtraBold" Foreground="#4F46E5" />
                    </StackPanel>
                    <TextBlock FontSize="15" FontWeight="Bold" Foreground="#334155"><Run Text="평일" /><Run Text="          |  " Foreground="#CBD5E1" /><Run Text="10:00~18:00" /></TextBlock>
                    <TextBlock FontSize="15" FontWeight="Bold" Foreground="#334155"><Run Text="점심시간" /><Run Text="   |  " Foreground="#CBD5E1" /><Run Text="12:00~13:30" /></TextBlock>
                    <TextBlock FontSize="15" FontWeight="Bold" Foreground="#334155"><Run Text="토요일" /><Run Text="       |  " Foreground="#CBD5E1" /><Run Text="10:00~14:00" /></TextBlock>
                    <Border Height="1" Background="#E5E7EB" Margin="0,10,0,8" />
                    <Image Source="pack://application:,,,/Assets/chat.png" Stretch="Uniform" MaxWidth="440" Cursor="Hand" ToolTip="카카오톡 채팅 상담" MouseLeftButtonUp="Chat_Click" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
