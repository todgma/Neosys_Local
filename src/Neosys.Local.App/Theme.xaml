<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 기존 프런트(React + Tailwind) 색: indigo-600 주색, slate/gray 계열 테두리·글자 -->
    <Color x:Key="PrimaryColor">#4F46E5</Color>
    <SolidColorBrush x:Key="Primary" Color="#4F46E5" />
    <SolidColorBrush x:Key="PrimaryDark" Color="#4338CA" />
    <SolidColorBrush x:Key="PrimaryLight" Color="#EEF2FF" />
    <SolidColorBrush x:Key="PrimaryBorder" Color="#C7D2FE" />
    <SolidColorBrush x:Key="Violet" Color="#7C3AED" />
    <SolidColorBrush x:Key="LabelBack" Color="#8B7AD8" />
    <SolidColorBrush x:Key="LabelFore" Color="White" />
    <SolidColorBrush x:Key="Border" Color="#E2E8F0" />
    <SolidColorBrush x:Key="BorderStrong" Color="#CBD5E1" />
    <SolidColorBrush x:Key="PanelBack" Color="#F8FAFC" />
    <SolidColorBrush x:Key="PageBack" Color="#F9FAFB" />
    <SolidColorBrush x:Key="HeaderBack" Color="#F1F5F9" />
    <SolidColorBrush x:Key="Text" Color="#111827" />
    <SolidColorBrush x:Key="TextSub" Color="#334155" />
    <SolidColorBrush x:Key="Muted" Color="#64748B" />
    <SolidColorBrush x:Key="Faint" Color="#94A3B8" />
    <SolidColorBrush x:Key="Danger" Color="#DC2626" />
    <SolidColorBrush x:Key="DangerBorder" Color="#FCA5A5" />
    <SolidColorBrush x:Key="Success" Color="#059669" />
    <SolidColorBrush x:Key="NavBack" Color="#1F2937" />
    <SolidColorBrush x:Key="NavFore" Color="#F9FAFB" />
    <!-- 기존 index.html @font-face Pretendard(앱에 포함: Assets/Fonts) → 없으면 맑은 고딕 -->
    <FontFamily x:Key="AppFont">pack://application:,,,/Assets/Fonts/#Pretendard, Malgun Gothic</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <Style TargetType="{x:Type Window}">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>

    <!-- 입력칸: 기존 목록 검색칸(padding 5px 8px · rounded 4px · #cbd5e1) / 등록폼 칸은 FormTextBox(각진 모서리) -->
    <Style TargetType="TextBox">
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Tag" Value="4" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="0" Padding="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="#6366F1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Background" Value="#F1F5F9" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- 등록폼 입력칸(기존 PropertyFormPageV2: border 1px #cbd5e1 · 모서리 없음 · padding 2px · 13px) -->
    <Style x:Key="FormTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Tag" Value="0" />
        <Setter Property="Padding" Value="4,1" />
        <Setter Property="MinHeight" Value="26" />
    </Style>
    <Style TargetType="PasswordBox">
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}" />
    </Style>
    <!-- select: 기존 globals.css min-height 28px -->
    <Style TargetType="ComboBox">
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}" />
        <Setter Property="Background" Value="White" />
    </Style>
    <Style TargetType="DatePicker">
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}" />
    </Style>
    <Style TargetType="CheckBox">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,12,0" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>
    <Style TargetType="RadioButton">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,12,0" />
    </Style>

    <!-- 버튼: 흰 바탕 · 회색 테두리 · 둥근 모서리(기존 btn) -->
    <Style TargetType="Button">
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="Background" Value="White" />
        <Setter Property="Foreground" Value="#374151" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.86" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource Primary}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderBrush" Value="{StaticResource Primary}" />
    </Style>
    <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource Success}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderBrush" Value="{StaticResource Success}" />
    </Style>
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="{StaticResource Danger}" />
        <Setter Property="BorderBrush" Value="{StaticResource DangerBorder}" />
    </Style>
    <!-- 텍스트만 있는 작은 버튼(링크형) -->
    <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="2,0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
    </Style>

    <!-- 입력 폼 라벨(기존 PropertyFormPageV2: #8b7ad8 바탕 · 흰 글자 · #5b4aa8 테두리, 폭 90) -->
    <Style x:Key="FieldLabel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource LabelBack}" />
        <Setter Property="BorderBrush" Value="#5B4AA8" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="MinWidth" Value="90" />
    </Style>
    <Style x:Key="SectionHeader" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Margin" Value="0,12,0,6" />
    </Style>
    <!-- 흰 카드(rounded-lg border) -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="#E5E7EB" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="SelectionMode" Value="Extended" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="#E5E7EB" />
        <Setter Property="RowHeight" Value="34" />
        <Setter Property="BorderBrush" Value="#E5E7EB" />
        <Setter Property="Background" Value="White" />
        <Setter Property="RowBackground" Value="White" />
        <Setter Property="AlternatingRowBackground" Value="White" />
        <Setter Property="EnableRowVirtualization" Value="True" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#F8FAFC" />
        <Setter Property="Foreground" Value="#111827" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Padding" Value="8,8" />
        <Setter Property="BorderBrush" Value="#E5E7EB" />
        <Setter Property="BorderThickness" Value="0,0,1,2" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style TargetType="DataGridCell">
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#EEF2FF" />
                <Setter Property="Foreground" Value="#111827" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="DataGridRow">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#F8FAFC" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 탭(기존 화면 상단 탭 버튼: 선택 시 인디고 밑줄) -->
    <Style TargetType="TabItem">
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="bd" Background="White" BorderBrush="#E5E7EB" BorderThickness="1,1,1,0" CornerRadius="6,6,0,0" Padding="{TemplateBinding Padding}" Margin="0,0,2,0">
                        <ContentPresenter x:Name="cp" ContentSource="Header" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#EEF2FF" />
                            <Setter TargetName="bd" Property="BorderBrush" Value="#4F46E5" />
                            <Setter Property="Foreground" Value="#4F46E5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 대시보드 메뉴 카드 -->
    <Style x:Key="MenuTile" TargetType="Button">
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="#E5E7EB" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.15" Direction="270" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- (예전) 좌측 메뉴 — 사용하지 않지만 다른 화면 호환용으로 남김 -->
    <Style x:Key="NavButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource NavFore}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="18,9" />
        <Setter Property="FontSize" Value="14" />
    </Style>
</ResourceDictionary>
