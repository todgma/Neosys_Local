                    value={formData.cnAmt}
                    onChange={(e) => handleChange('cnAmt', e.target.value)}
                    className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500"
                  />
                </div>

                <div>
                  <label className="block text-sm font-medium text-gray-700 mb-1">계약금 납입일</label>
                  <input
                    type="date"
                    value={formData.cnAmtDate}
                    onChange={(e) => handleChange('cnAmtDate', e.target.value)}
                    className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500"
                  />
                </div>

                <div>
                  <label className="block text-sm font-medium text-gray-700 mb-1">중도금(원)</label>
                  <input
                    type="number"
                    value={formData.midAmt}
                    onChange={(e) => handleChange('midAmt', e.target.value)}
                    className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500"
                  />
                </div>

                <div>
                  <label className="block text-sm font-medium text-gray-700 mb-1">중도금 납입일</label>
                  <input
                    type="date"
                    value={formData.midAmtDate}
                    onChange={(e) => handleChange('midAmtDate', e.target.value)}
                    className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500"
                  />
                </div>

                <div>
                  <label className="block text-sm font-medium text-gray-700 mb-1">잔금(원)</label>
                  <input
                    type="number"
                    value={formData.rmdAmt}
                    onChange={(e) => handleChange('rmdAmt', e.target.value)}
                    className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500"
                  />
                </div>

                <div>
                  <label className="block text-sm font-medium text-gray-700 mb-1">잔금 납입일</label>
                  <input
                    type="date"
                    value={formData.rmdAmtDate}
                    onChange={(e) => handleChange('rmdAmtDate', e.target.value)}
                    className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500"
                  />
                </div>

                <div className="col-span-3">
                  <label className="block text-sm font-medium text-gray-700 mb-1">특약내용</label>
                  <textarea
                    value={formData.spcCnDesc}
                    onChange={(e) => handleChange('spcCnDesc', e.target.value)}
                    rows="3"
                    className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500"
                  />
                </div>
              </div>
            </div> */}

          {/* ■ 예정일/기타 정보 */}
          <div style={{ marginTop: '8px' }}>
            <div style={{ fontSize: '13px', fontWeight: '600', marginBottom: '4px', color: '#1e293b' }}>■ 예정일/기타 정보</div>
            <table style={{ width: '100%', fontSize: '13px', borderCollapse: 'collapse' }}>
              <tbody>
                <tr>
                  <td style={{ padding: '2px 4px', width: '90px', fontWeight: '500', border: '1px solid #cbd5e1' }}>진행상태</td>
                  <td style={{ padding: '2px', border: '1px solid #cbd5e1' }}>
                    <select value={formData.prgSts} onChange={(e) => handleChange('prgSts', e.target.value)} style={{ width: '100%', padding: '2px 4px', fontSize: '13px', border: '1px solid #cbd5e1' }}>
                      <option value="PRGSTS01">접수</option>
                      <option value="PRGSTS02">진행중</option>
                      <option value="PRGSTS03">완료</option>
                      <option value="PRGSTS04">보류</option>
                    </select>
                  </td>
                  <td style={{ padding: '2px 4px', width: '90px', fontWeight: '500', border: '1px solid #cbd5e1' }}>만기일</td>
                  <td style={{ padding: '2px', border: '1px solid #cbd5e1' }}>
                    <input type="date" value={formData.mtryDate} onChange={(e) => handleChange('mtryDate', e.target.value)} style={{ width: '100%', padding: '2px 4px', fontSize: '13px', border: '1px solid #cbd5e1' }} />
                  </td>
                  <td style={{ padding: '2px 4px', width: '90px', fontWeight: '500', border: '1px solid #cbd5e1' }}>이사예정일</td>
                  <td style={{ padding: '2px', border: '1px solid #cbd5e1' }}>
                    <input type="date" value={formData.exptMovDate} onChange={(e) => handleChange('exptMovDate', e.target.value)} style={{ width: '100%', padding: '2px 4px', fontSize: '13px', border: '1px solid #cbd5e1' }} />
                  </td>
                </tr>
                <tr>
                  <td style={{ padding: '2px 4px', fontWeight: '500', border: '1px solid #cbd5e1' }}>입주예정일</td>
                  <td style={{ padding: '2px', border: '1px solid #cbd5e1' }}>
                    <input type="date" value={formData.exptDate} onChange={(e) => handleChange('exptDate', e.target.value)} style={{ width: '100%', padding: '2px 4px', fontSize: '13px', border: '1px solid #cbd5e1' }} />
                  </td>
                  <td style={{ padding: '2px 4px', fontWeight: '500', border: '1px solid #cbd5e1' }}>준공예정일</td>
                  <td style={{ padding: '2px', border: '1px solid #cbd5e1' }}>
                    <input type="date" value={formData.exptComDate} onChange={(e) => handleChange('exptComDate', e.target.value)} style={{ width: '100%', padding: '2px 4px', fontSize: '13px', border: '1px solid #cbd5e1' }} />
                  </td>
                  <td style={{ padding: '2px 4px', fontWeight: '500', border: '1px solid #cbd5e1' }}>공유여부</td>
                  <td style={{ padding: '2px', border: '1px solid #cbd5e1' }}>
                    <select value={formData.shaYn} onChange={(e) => handleChange('shaYn', e.target.value)} style={{ width: '100%', padding: '2px 4px', fontSize: '13px', border: '1px solid #cbd5e1' }}>
                      <option value="N">비공유</option>
                      <option value="Y">공유</option>
                    </select>
                  </td>
                </tr>
                <tr>
                  <td style={{ padding: '2px 4px', fontWeight: '500', border: '1px solid #cbd5e1' }}>옵션</td>
                  <td style={{ padding: '2px', border: '1px solid #cbd5e1' }}>
                    <input type="text" value={formData.opt} onChange={(e) => handleChange('opt', e.target.value)} placeholder="풀옵션" style={{ width: '100%', padding: '2px 4px', fontSize: '13px', border: '1px solid #cbd5e1' }} />
                  </td>
                  <td style={{ padding: '2px 4px', fontWeight: '500', border: '1px solid #cbd5e1' }}>이전가능</td>
                  <td style={{ padding: '2px', border: '1px solid #cbd5e1' }}>
                    <select value={formData.mvnPsbYn} onChange={(e) => handleChange('mvnPsbYn', e.target.value)} style={{ width: '100%', padding: '2px 4px', fontSize: '13px', border: '1px solid #cbd5e1' }}>
                      <option value="N">불가</option>
                      <option value="Y">가능</option>
                    </select>
                  </td>
                  <td style={{ padding: '2px 4px', fontWeight: '500', border: '1px solid #cbd5e1' }}>임대주택</td>
                  <td style={{ padding: '2px', border: '1px solid #cbd5e1' }}>
                    <select value={formData.houseRental} onChange={(e) => handleChange('houseRental', e.target.value)} style={{ width: '100%', padding: '2px 4px', fontSize: '13px', border: '1px solid #cbd5e1' }}>
                      <option value="N">아니오</option>
                      <option value="Y">예</option>
                    </select>
                  </td>
                </tr>
                <tr>
                  <td style={{ padding: '2px 4px', fontWeight: '500', border: '1px solid #cbd5e1' }}>반려동물</td>
                  <td style={{ padding: '2px', border: '1px solid #cbd5e1' }} colSpan="2">
                    <select value={formData.petYn} onChange={(e) => handleChange('petYn', e.target.value)} style={{ width: '100%', padding: '2px 4px', fontSize: '13px', border: '1px solid #cbd5e1' }}>
                      <option value="N">불가</option>
                      <option value="Y">가능</option>
                    </select>
                  </td>
                  <td style={{ padding: '2px 4px', fontWeight: '500', border: '1px solid #cbd5e1' }}>탑층여부</td>
                  <td style={{ padding: '2px', border: '1px solid #cbd5e1' }} colSpan="2">
                    <select value={formData.top} onChange={(e) => handleChange('top', e.target.value)} style={{ width: '100%', padding: '2px 4px', fontSize: '13px', border: '1px solid #cbd5e1' }}>
                      <option value="">선택</option>
                      <option value="Y">예</option>
                      <option value="N">아니오</option>
                    </select>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>

          </div>
          )}

          {activeTab === 'attachments' && (
            <div>
              <div style={{ padding: '40px', textAlign: 'center', color: '#94a3b8' }}>
                <Paperclip className="w-12 h-12 mx-auto mb-4" style={{ color: '#cbd5e1' }} />
                <p style={{ fontSize: '14px' }}>첨부파일 기능은 준비 중입니다.</p>
              </div>
            </div>
          )}

          {activeTab === 'detail' && (
            <div style={{ padding: '40px', textAlign: 'center', color: '#94a3b8' }}>
              <MessageSquare className="w-12 h-12 mx-auto mb-4" style={{ color: '#cbd5e1' }} />
              <p style={{ fontSize: '14px' }}>상세정보 기능은 준비 중입니다.</p>
            </div>
          )}
        </div>

        {/* 푸터 버튼 */}
        {activeTab === 'property' && (
        <div className="page-footer">
        <button
          type="button"
          onClick={() => {
            if (editData && editData.ptNo) {
              openWithProperty(editData);
            } else {
              toast.error('저장된 물건 정보만 정보망 전송이 가능합니다.');
            }
          }}
          className="px-4 py-2 text-sm font-medium text-white bg-sky-500 rounded-md hover:bg-sky-600"
        >
          정보망전송
        </button>
        <div className="flex gap-3">
          <button
            type="button"
            onClick={onClose}
            className="px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50"
          >
            취소
          </button>
          <button
            type="submit"
            disabled={loading}
            onClick={handleSubmit}
            className="px-4 py-2 text-sm font-medium text-white bg-indigo-600 rounded-md hover:bg-indigo-700 disabled:opacity-50"
          >
            {loading ? '저장 중...' : (editData ? '수정' : '등록')}
          </button>
        </div>
        </div>
        )}
      </form>

      <style>{`
        .property-form-page {
          height: 100vh;
          display: flex;
          flex-direction: column;
          background-color: #f9fafb;
        }

        .page-header {
          display: flex;
          align-items: center;
          justify-content: space-between;
          padding: 0.5rem 1rem;
          background-color: white;
          border-bottom: 1px solid #e5e7eb;
          flex-shrink: 0;
        }

        .page-title {
          font-size: 1.125rem;
          font-weight: 600;
          color: #111827;
        }

        .close-btn {
          padding: 0.5rem;
          border-radius: 0.375rem;
          border: none;
          background: none;
          cursor: pointer;
          color: #6b7280;
          transition: all 0.2s;
        }

        .close-btn:hover {
          background-color: #f3f4f6;
          color: #111827;
        }

        .page-form {
          flex: 1;
          display: flex;
          flex-direction: column;
          overflow: hidden;
        }

        .form-content {
          flex: 1;
          overflow-y: auto;
          padding: 1.5rem;
        }

        .page-footer {
          display: flex;
          align-items: center;
          justify-content: space-between;
          padding: 1rem 1.5rem;
          background-color: white;
          border-top: 1px solid #e5e7eb;
          flex-shrink: 0;
        }

}
        @keyframes pulse-slow {
          0%, 100% {
            box-shadow: 0 2px 4px rgba(99, 102, 241, 0.4);
          }
          50% {
            box-shadow: 0 4px 12px rgba(99, 102, 241, 0.8);
          }
        }

        .animate-pulse-slow {
          animation: pulse-slow 2s ease-in-out infinite;
        }

        .animate-pulse-slow:hover {
          animation: none;
        }

        @keyframes slideDown {
          from {
            opacity: 0;
            transform: translateY(-10px);
          }
          to {
            opacity: 1;
            transform: translateY(0);
          }
        }

        .animate-slideDown {
          animation: slideDown 0.3s ease-out;
        }
      `}</style>

      {/* Holder 상세보기 모달 */}
      {holderDetailModal.open && (
        <div style={{
          position: 'fixed',
          top: 0,
          left: 0,
          right: 0,
          bottom: 0,
          background: 'rgba(0,0,0,0.5)',
          display: 'flex',
          alignItems: 'center',
          justifyContent: 'center',
          zIndex: 10000,
        }} onClick={closeHolderDetailModal}>
          <div style={{
            background: 'white',
            padding: '20px',
            borderRadius: '8px',
            width: '400px',
            maxWidth: '90%',
          }} onClick={(e) => e.stopPropagation()}>
            <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: '16px' }}>
              <h3 style={{ margin: 0, fontSize: '16px', fontWeight: '600' }}>
                {holderDetailModal.type === 'OWNER' && '소유주 상세정보'}
                {holderDetailModal.type === 'SELLER' && '매도인/임대인 상세정보'}
                {holderDetailModal.type === 'BUYER' && '임차인 상세정보'}
              </h3>
              <button
                type="button"
                onClick={closeHolderDetailModal}
                style={{
                  border: 'none',
                  background: 'none',
                  fontSize: '20px',
                  cursor: 'pointer',
                  padding: '4px',
                }}
              >
                ×
              </button>
            </div>
            <div style={{ borderTop: '1px solid #e2e8f0', paddingTop: '16px' }}>
              <table style={{ width: '100%', fontSize: '14px', borderCollapse: 'collapse' }}>
                <tbody>
                  <tr>
                    <td style={{ padding: '8px', fontWeight: '500', width: '120px', borderBottom: '1px solid #e2e8f0' }}>구분</td>
                    <td style={{ padding: '8px', borderBottom: '1px solid #e2e8f0' }}>
                      {holderDetailModal.type === 'OWNER' && '소유주'}
                      {holderDetailModal.type === 'SELLER' && '매도인/임대인'}
                      {holderDetailModal.type === 'BUYER' && '임차인'}
                    </td>
                  </tr>
                  <tr>
                    <td style={{ padding: '8px', fontWeight: '500', borderBottom: '1px solid #e2e8f0' }}>성명</td>
                    <td style={{ padding: '8px', borderBottom: '1px solid #e2e8f0' }}>
                      {holderDetailModal.data?.holderName || '-'}
                    </td>
                  </tr>
                  <tr>
                    <td style={{ padding: '8px', fontWeight: '500', borderBottom: '1px solid #e2e8f0' }}>연락처</td>
                    <td style={{ padding: '8px', borderBottom: '1px solid #e2e8f0' }}>
                      {holderDetailModal.data?.holderPhone || '-'}
                    </td>
                  </tr>
                  <tr>
                    <td style={{ padding: '8px', fontWeight: '500', borderBottom: '1px solid #e2e8f0' }}>고객번호</td>
                    <td style={{ padding: '8px', borderBottom: '1px solid #e2e8f0' }}>
                      {holderDetailModal.data?.custNo || '-'}
                    </td>
                  </tr>
                  {holderDetailModal.type === 'OWNER' && (
                    <>
                      <tr>
                        <td style={{ padding: '8px', fontWeight: '500', borderBottom: '1px solid #e2e8f0' }}>관계</td>
                        <td style={{ padding: '8px', borderBottom: '1px solid #e2e8f0' }}>
                          {holderDetailModal.data?.holderRelation || '-'}
                        </td>
                      </tr>
                      <tr>
                        <td style={{ padding: '8px', fontWeight: '500', borderBottom: '1px solid #e2e8f0' }}>등록일자</td>
                        <td style={{ padding: '8px', borderBottom: '1px solid #e2e8f0' }}>
                          {holderDetailModal.data?.holderRegDate || '-'}
                        </td>
                      </tr>
                      <tr>
                        <td style={{ padding: '8px', fontWeight: '500', borderBottom: '1px solid #e2e8f0' }}>메모</td>
                        <td style={{ padding: '8px', borderBottom: '1px solid #e2e8f0' }}>
                          {holderDetailModal.data?.holderMemo || '-'}
                        </td>
                      </tr>
                    </>
                  )}
                </tbody>
              </table>
            </div>
            <div style={{ marginTop: '16px', textAlign: 'right' }}>
              <button
                type="button"
                onClick={closeHolderDetailModal}
                style={{
                  padding: '8px 16px',
                  background: '#3b82f6',
                  color: 'white',
                  border: 'none',
                  borderRadius: '4px',
                  cursor: 'pointer',
                  fontSize: '14px',
                }}
              >
                닫기
              </button>
            </div>
          </div>
        </div>
      )}
    </div>
  );
};

export default PropertyFormPage;
