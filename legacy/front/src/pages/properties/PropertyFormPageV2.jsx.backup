                    <td style={{ padding: '2px 4px', width: '90px', fontWeight: '600', border: '1px solid #cbd5e1', background: '#f8fafc' }}>기타제한사항</td>
                    <td style={{ padding: '2px 4px', border: '1px solid #cbd5e1' }}>
                      <input type="text" value={formData.otherRestrictions} onChange={(e) => handleChange('otherRestrictions', e.target.value)} placeholder="예: 주차장 제한" style={{ width: '100%', padding: '2px 4px', fontSize: '13px', border: 'none' }} />
                    </td>
                    <td style={{ padding: '2px 4px', width: '90px', fontWeight: '600', border: '1px solid #cbd5e1', background: '#f8fafc' }}>계약갱신청구권</td>
                    <td style={{ padding: '2px 4px', border: '1px solid #cbd5e1' }}>
