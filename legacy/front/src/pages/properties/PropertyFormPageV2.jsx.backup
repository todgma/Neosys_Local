import React, { useState, useEffect } from 'react';
import { propertyService } from '../../services/propertyService';
import { holderService } from '../../services/holderService';
import addressService from '../../services/common/addressService';
import { loadAddressFromBjdCode } from '../../utils/addressUtils';
import { useAuthStore } from '../../stores/authStore';
import { useHubModalStore } from '../../stores/hubModalStore';
import ConsultationHistoryPanel from '../../components/consultation/ConsultationHistoryPanel';
import HolderSection from '../../components/property/HolderSection';
import AddressSelector from '../../components/property/AddressSelector';
import HolderInlineEdit from '../../components/property/HolderInlineEdit';
import PropertyShareHistoryModal from '../../components/property/PropertyShareHistoryModal';
import OptionModal from '../../components/property/OptionModal';
import { toast } from 'react-hot-toast';
import { X, FileText, Paperclip, MessageSquare } from 'lucide-react';
import { PROPERTY_TYPES } from '../../constants/propertyTypes';
import { LAND_CATEGORIES } from '../../constants/landCategories';
import { BUILDING_USES } from '../../constants/buildingUses';
import { LAND_USES } from '../../constants/landUses';

const PropertyFormPage = ({ editData = null, onClose, onSuccess }) => {
  console.log(editData);
  const { user } = useAuthStore();
  const { openWithProperty } = useHubModalStore();

  // 디버깅: user 객체 확인
  console.log('PropertyFormPage user:', user);
  const [activeTab, setActiveTab] = useState('property');
  const [loading, setLoading] = useState(false);
  const [expandedSections, setExpandedSections] = useState({
    ownerInfo: false,
    tenantInfo: false,
  });
  const [holders, setHolders] = useState([]);
  const [danjiList, setDanjiList] = useState([]);
  const [consultations, setConsultations] = useState([]);
  const [shareHistory, setShareHistory] = useState([]);
  const [showShareHistoryModal, setShowShareHistoryModal] = useState(false);
  const [showOptionModal, setShowOptionModal] = useState(false);
  const [formData, setFormData] = useState({
    ptName: '',
    ptSts: 'PTSTS01', // 물건상태
    ptType: 'SYCA101', // 물건유형 (아파트)
    ptExpl: '',
    saleDiv: ['SALEDIV01'], // 거래구분 (배열)
    addr1: '',
    addr2: '',
    addr3: '',
    addr4: '',
    addr5: '',
    addrPost: '',
    bjdCode: '',
    danjiCode: '',
    dong: '',
    ho: '',
    floor: '',
    opt: '',
    houseCnt: '',
    aptTyp: '',
    supArea: '',
    excArea: '',
    landShare: '',
    roomCnt: '',
    bathCnt: '',
    dirStd: '',
    heatMethod: '',
    heatFuel: '',
    entrStruct: '',
    buidStruct: '',
    balcExt: '',
    floor1: '',
    floor2: '',
    pkCnt: '',
    maintCost: '',
    maintDtl: '',
    saleAmt: '',
    lesAmt: '',
    protAmt: '',
    monAmt: '',
    etcAmt: '',
    layAmt: '',
    nowDepAmt: '',
    nowMonAmt: '',
    loanAmt: '',
    loanAmtAft: '',
    mtryDate: '',
    exptMovDate: '',
    exptDate: '',
    exptComDate: '',
    balDate: '',
    compYear: '',
    shaYn: 'N',
    custNo: '',
    offNo: user?.offNo || null,
    rtNo: user?.rtNo || null,
    mvnPsbYn: 'N',
    houseRental: 'N',
    petYn: 'N',
    top: '',
    ptMemo: '',
    userId: user?.userId || '',
    landUse: '',              // 용도지역
    buildingUse: '',          // 건축물용도
    landCategory: '',         // 지목
    otherRestrictions: '',    // 기타제한사항
    contractRenewalRight: '', // 계약갱신청구권
    housingRentalBusiness: '',// 주택임대사업자
    currentStatus: '',        // 현상태
    businessType: '',         // 업종
    businessName: '',         // 상호
  });


  const propertyStatuses = [
    { value: 'PTSTS01', label: '진행중' },
    { value: 'PTSTS02', label: '계약' },
    { value: 'PTSTS03', label: '타계' },
    { value: 'PTSTS04', label: '보류' },
  ];

  const tradeDivisions = [
    { value: 'SALEDIV01', label: '매매' },
    { value: 'SALEDIV02', label: '전세' },
    { value: 'SALEDIV03', label: '월세' },
    { value: 'SALEDIV04', label: '기타임대' },
  ];

  const tabs = [
    { id: 'property', label: '기본정보', icon: FileText },
    { id: 'attachments', label: '평면도/사진', icon: Paperclip },
  ];

  useEffect(() => {
    const loadDetailData = async () => {
      if (editData?.ptNo) {
        try {
          // 상세 조회 API 호출
          const response = await propertyService.getDetail(editData.ptNo);
          if (response?.data) {
            const detailData = response.data;
            setFormData({
              ptName: '',
              ptSts: 'PTSTS01',
              ptType: 'SYCA101',
              ptExpl: '',
              saleDiv: ['SALEDIV01'],
              addr1: '',
              addr2: '',
              addr3: '',
              addr4: '',
              addr5: '',
              addrPost: '',
              bjdCode: '',
              danjiCode: '',
              dong: '',
              ho: '',
              floor: '',
              opt: '',
              houseCnt: '',
              aptTyp: '',
              supArea: '',
              excArea: '',
              landShare: '',
              roomCnt: '',
              bathCnt: '',
              dirStd: '',
              heatMethod: '',
              heatFuel: '',
              entrStruct: '',
              buidStruct: '',
              balcExt: '',
              floor1: '',
              floor2: '',
              pkCnt: '',
              maintCost: '',
              maintDtl: '',
              saleAmt: '',
              lesAmt: '',
              protAmt: '',
              monAmt: '',
              etcAmt: '',
              layAmt: '',
              nowDepAmt: '',
              nowMonAmt: '',
              loanAmt: '',
              loanAmtAft: '',
              mtryDate: '',
              exptMovDate: '',
              exptDate: '',
              exptComDate: '',
              balDate: '',
              compYear: '',
              shaYn: 'N',
              custNo: '',
              offNo: user?.offNo || null,
              rtNo: user?.rtNo || null,
              mvnPsbYn: 'N',
              houseRental: 'N',
              petYn: 'N',
              top: '',
              ptMemo: '',
              userId: user?.userId || '',
              regDt: '',
              regId: '',
              updDt: '',
              updId: '',
              ...detailData,
              // null/undefined 체크
              ptSts: detailData.ptSts || 'PTSTS01',
              saleDiv: detailData.saleDiv ? (typeof detailData.saleDiv === 'string' ? detailData.saleDiv.split(',') : detailData.saleDiv) : ['SALEDIV01'],
            });

            // BjdCode로 주소 select 자동 설정
            if (detailData.bjdCode) {
              await loadAddressFromBjdCode(
                detailData.bjdCode,
                setSidoList,
                setSigunguList,
                setEupMyeonDongList,
                setSelectedSido,
                setSelectedSigungu,
                setSelectedEupMyeonDong
              );

              // 단지 목록도 자동 조회 (아파트/오피스텔 등인 경우)
              const isDanjiProperty = ['SYCA101', 'SYCA102', 'SYCA103', 'SYCA105', 'SYCA106', 'SYCA107'].includes(detailData.ptType);
              if (isDanjiProperty && detailData.bjdCode) {
                setIsDanjiLoading(true);
                try {
                  const data = await addressService.getDanjiListByBjd(detailData.bjdCode);
                  setDanjiList(data || []);
                } catch (error) {
                  console.error('단지 목록 조회 실패:', error);
                } finally {
                  setIsDanjiLoading(false);
                }
              }
            }

            // holders 데이터 설정 (API 응답에 이미 포함되어 있음)
            if (detailData.holders && detailData.holders.length > 0) {
              setHolders(detailData.holders);
            }
          }
        } catch (error) {
          console.error('상세 데이터 로드 실패:', error);
        }
      }
    };

    console.log('=== PropertyFormPage useEffect triggered ===');
    console.log('editData:', editData);
    console.log('editData?.ptNo:', editData?.ptNo);
    console.log('Current formData before update:', formData);

    if (editData && editData.ptNo) {
      console.log('Branch: Loading existing property data');
      loadDetailData();
    } else {
      // 초기화 (신규 등록 또는 ptNo가 null인 경우)
      console.log('Branch: Initializing form for new property');
      setFormData({
        ptName: '',
        ptSts: 'PTSTS01',
        ptType: 'SYCA101',
        ptExpl: '',
        saleDiv: ['SALEDIV01'],
        addr1: '',
        addr2: '',
        addr3: '',
        addr4: '',
        addr5: '',
        addrPost: '',
        bjdCode: '',
        danjiCode: '',
        dong: '',
        ho: '',
        floor: '',
        opt: '',
        houseCnt: '',
        aptTyp: '',
        supArea: '',
        excArea: '',
        landShare: '',
        roomCnt: '',
        bathCnt: '',
        dirStd: '',
        heatMethod: '',
        heatFuel: '',
        entrStruct: '',
        buidStruct: '',
        balcExt: '',
        floor1: '',
        floor2: '',
        pkCnt: '',
        maintCost: '',
        maintDtl: '',
        saleAmt: '',
        lesAmt: '',
        protAmt: '',
        monAmt: '',
        etcAmt: '',
        layAmt: '',
        nowDepAmt: '',
        nowMonAmt: '',
        loanAmt: '',
        loanAmtAft: '',
        mtryDate: '',
        exptMovDate: '',
        exptDate: '',
        exptComDate: '',
        balDate: '',
        compYear: '',
        shaYn: 'N',
        custNo: '',
        offNo: user?.offNo || null,
        rtNo: user?.rtNo || null,
        mvnPsbYn: 'N',
        houseRental: 'N',
        petYn: 'N',
        top: '',
        ptMemo: '',
        userId: user?.userId || '',
      });
      console.log('Form data reset complete for new property');
      setHolders([]);
      console.log('Holders cleared');
    }
    console.log('=== useEffect complete ===');
  }, [editData]);

  const loadHolders = async (ptNo) => {
    try {
      const response = await holderService.getList(ptNo);
      if (response.success && response.data?.ptHolders) {
        setHolders(response.data.ptHolders);
      } else if (!response.success) {
        console.warn('소유주 정보 조회 실패 (백엔드 오류):', response.error);
        setHolders([]); // 빈 배열로 설정
      }
    } catch (error) {
      console.error('소유주 정보 조회 실패:', error);
      setHolders([]); // 빈 배열로 설정
    }
  };

  const toggleSection = (section) => {
    setExpandedSections((prev) => ({
      ...prev,
      [section]: !prev[section],
    }));
  };

  const handleChange = (field, value) => {
    // undefined나 null을 빈 문자열로 변환하여 controlled input 경고 방지
    const safeValue = value === undefined || value === null ? '' : value;
    setFormData(prev => ({ ...prev, [field]: safeValue }));
  };

  const handleSubmit = async (e) => {
    e.preventDefault();


    setLoading(true);
    try {
      // holders 배열에서 빈 행 제거하고 등록일자 설정
      const holdersData = holders
        .filter(h => h.holderName || h.holderPhone) // 이름이나 연락처가 있는 행만
        .map(h => ({
          ...h,
          holderRegDate: h.holderRegDate || new Date().toISOString().split('T')[0],
          custNo: h.custNo || null,
        }));

      // 숫자 필드 목록
      const numberFields = ['floor', 'houseCnt', 'floor1', 'floor2', 'roomCnt', 'bathCnt',
        'saleAmt', 'lesAmt', 'protAmt', 'monAmt', 'etcAmt', 'layAmt', 'nowDepAmt', 'nowMonAmt',
        'loanAmt', 'loanAmtAft', 'maintCost', 'cnNo', 'cnDoc', 'cnVer', 'tradeAmt',
        'cnAmtPart', 'cnAmt', 'midAmt', 'rmdAmt', 'custNo'];

      const decimalFields = ['supArea', 'excArea', 'landShare', 'pkCnt'];

      // 빈 문자열을 null로 변환하고 숫자 필드 변환
      const cleanedData = Object.entries(formData).reduce((acc, [key, value]) => {
        if (value === '' || value === undefined) {
          acc[key] = null;
        } else if (numberFields.includes(key) && value !== null) {
          acc[key] = parseInt(value) || null;
        } else if (decimalFields.includes(key) && value !== null) {
          acc[key] = parseFloat(value) || null;
        } else if (key === 'rtNo' && value !== null) {
          // rtNo는 숫자일 수 있지만 문자열로 전송
          acc[key] = String(value);
        } else {
          acc[key] = value;
        }
        return acc;
      }, {});

      // 물건 데이터에 holders 포함
      const propertyData = {
        ...cleanedData,
        saleDiv: Array.isArray(cleanedData.saleDiv) ? cleanedData.saleDiv.join(',') : cleanedData.saleDiv,
        holders: holdersData,
      };

      if (editData) {
        await propertyService.update(editData.ptNo, propertyData);
        toast.success('물건이 수정되었습니다.');
        onSuccess?.();
      } else {
        await propertyService.create(propertyData);
        toast.success('물건이 등록되었습니다.');
        onSuccess?.();
        // 등록 후에도 창을 닫지 않음
      }
    } catch (error) {
      console.error('물건 저장 실패:', error);
      toast.error(editData ? '물건 수정에 실패했습니다.' : '물건 등록에 실패했습니다.');
    } finally {
      setLoading(false);
    }
  };

  return (
    <div className="property-form-page">
      {/* 헤더 */}
      <div className="page-header">
        <div style={{ display: 'flex', alignItems: 'center', gap: '16px' }}>
          <h1 className="page-title">물건 등록/수정</h1>
          <div style={{ display: 'flex', gap: '4px', fontSize: '13px', color: '#64748b' }}>
            <span>담당자: {formData.userId || user?.userName || '-'}</span>
          </div>
          {editData && formData.regDt && (
            <div style={{ display: 'flex', gap: '12px', fontSize: '13px', color: '#64748b' }}>
              <span>등록자: {formData.regId || '-'}</span>
              <span>등록일: {formData.regDt ? new Date(formData.regDt).toLocaleDateString() : '-'}</span>
              <span style={{ color: '#ef4444', fontWeight: '500' }}>
                최근수정일: {formData.updDt ? new Date(formData.updDt).toLocaleString() : '-'}
              </span>
            </div>
          )}
        </div>
        <button
          type="button"
          onClick={onClose}
          className="close-btn"
          title="닫기"
        >
          <X className="w-5 h-5" />
        </button>
      </div>

      {/* 고정 영역: 매물유형 & 소재지 */}
      <div style={{ background: '#fefce8', borderBottom: '2px solid #fbbf24' }}>
        <table style={{ width: '100%', fontSize: '13px', borderCollapse: 'collapse', border: '1px solid #fbbf24' }}>
          <tbody>
            <AddressSelector
              formData={formData}
              onChange={handleChange}
              onDanjiListChange={setDanjiList}
              ptType={formData.ptType}
              aptType={formData.aptTyp}
              showPtTypeInSameLine={true}
              ptTypeValue={formData.ptType}
              onPtTypeChange={(e) => handleChange('ptType', e.target.value)}
            />
          </tbody>
        </table>
      </div>

      {/* 탭 네비게이션 */}
      <div style={{
        display: 'flex',
        borderBottom: '1px solid #e2e8f0',
        background: '#f8fafc'
      }}>
        {tabs.map((tab) => (
          <button
            key={tab.id}
            type="button"
            onClick={() => setActiveTab(tab.id)}
            style={{
              padding: '12px 24px',
              border: 'none',
              background: activeTab === tab.id ? 'white' : 'transparent',
              borderBottom: activeTab === tab.id ? '2px solid #3b82f6' : '2px solid transparent',
              color: activeTab === tab.id ? '#3b82f6' : '#64748b',
              fontWeight: activeTab === tab.id ? '600' : '400',
              cursor: 'pointer',
              display: 'flex',
              alignItems: 'center',
              gap: '8px',
              fontSize: '14px',
            }}
          >
            {tab.label}
          </button>
        ))}
      </div>

      {/* 폼 */}
      <form onSubmit={handleSubmit} className="page-form">
        <div className="form-content" style={{ overflow: 'auto', maxHeight: 'calc(100vh - 200px)', padding: '8px' }}>
          {activeTab === 'property' && (
          <div>
          {/* 상단 3개 카드 한 줄: 소유주 | 임차인 | 부동산공유이력 */}
          <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr 1fr', gap: '6px', marginBottom: '6px' }}>
            {/* 1. 소유주 카드 */}
            <HolderInlineEdit
              holders={holders}
              onHoldersChange={setHolders}
              holderType="OWNER"
              title="소유주"
              bgColor="#f8fafc"
              buttonColor="#3b82f6"
              ptNo={editData?.ptNo}
            />

            {/* 2. 임차인 카드 */}
            <HolderInlineEdit
              holders={holders}
              onHoldersChange={setHolders}
              holderType="BUYER"
              title="임차인"
              bgColor="#faf5ff"
              buttonColor="#8b5cf6"
              ptNo={editData?.ptNo}
            />

            {/* 3. 부동산공유이력 카드 */}
            <div style={{ border: '1px solid #cbd5e1', padding: '6px', background: '#e0f2fe' }}>
            <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', marginBottom: '6px' }}>
              <div style={{ fontSize: '13px', fontWeight: '600', color: '#1e293b' }}>부동산공유이력</div>
              <div style={{ display: 'flex', gap: '4px' }}>
                <button
                  type="button"
                  onClick={() => setShowShareHistoryModal(true)}
                  style={{ padding: '2px 6px', fontSize: '11px', border: '1px solid #64748b', background: 'white', color: '#64748b', cursor: 'pointer', borderRadius: '3px' }}
                >
                  크게보기(편집)
                </button>
              </div>
            </div>
            <div style={{ maxHeight: '150px', overflow: 'auto' }}>
            <table style={{ width: '100%', fontSize: '11px', borderCollapse: 'collapse', background: 'white' }}>
              <thead>
                <tr style={{ background: '#f1f5f9' }}>
                  <th style={{ padding: '4px 2px', border: '1px solid #cbd5e1', width: '80px' }}>날짜</th>
                  <th style={{ padding: '4px 2px', border: '1px solid #cbd5e1' }}>부동산명</th>
                  <th style={{ padding: '4px 2px', border: '1px solid #cbd5e1', width: '100px' }}>부동산 연락처</th>
                  <th style={{ padding: '4px 2px', border: '1px solid #cbd5e1' }}>메모</th>
                </tr>
              </thead>
              <tbody>
                {shareHistory.length === 0 ? (
                  <tr>
                    <td colSpan={4} style={{ padding: '10px', textAlign: 'center', color: '#94a3b8', fontSize: '11px', border: '1px solid #cbd5e1' }}>
                      부동산공유이력 정보 없음
                    </td>
                  </tr>
                ) : (
                  shareHistory.map((item, idx) => (
                    <tr key={idx}>
                      <td style={{ padding: '2px', border: '1px solid #cbd5e1', fontSize: '11px' }}>
                        {item.shareDate ? new Date(item.shareDate).toLocaleDateString('ko-KR', { month: '2-digit', day: '2-digit' }) : '-'}
                      </td>
                      <td style={{ padding: '2px 4px', border: '1px solid #cbd5e1', fontSize: '11px' }}>
                        {item.officeName || '-'}
                      </td>
                      <td style={{ padding: '2px 4px', border: '1px solid #cbd5e1', fontSize: '11px' }}>
                        {item.officePhone || '-'}
                      </td>
                      <td style={{ padding: '2px 4px', border: '1px solid #cbd5e1', fontSize: '11px' }}>
                        {item.memo || '-'}
                      </td>
                    </tr>
                  ))
                )}
              </tbody>
            </table>
            </div>
            </div>

            {/* 부동산공유이력 모달 */}
            <PropertyShareHistoryModal
              isOpen={showShareHistoryModal}
              onClose={() => setShowShareHistoryModal(false)}
              shareHistory={shareHistory}
              onShareHistoryChange={setShareHistory}
              ptNo={editData?.ptNo}
            />
          </div>

          {/* 기본 정보 입력 테이블 */}
          <div>
            <table style={{ width: '100%', fontSize: '13px', borderCollapse: 'collapse' }}>
              <tbody>
                {/* 거래구분 / 물건상태 / 현상태 - 3개 */}
                <tr>
                  <td style={{ padding: '2px 4px', width: '90px', fontWeight: '600', border: '1px solid #cbd5e1', background: '#f8fafc' }}>거래구분 *</td>
                  <td style={{ padding: '2px 4px', border: '1px solid #cbd5e1' }} colSpan="3">
                    <div style={{ display: 'flex', gap: '8px', flexWrap: 'wrap' }}>
                      {tradeDivisions.map((division) => (
                        <label key={division.value} style={{ display: 'flex', alignItems: 'center', gap: '4px', cursor: 'pointer', fontSize: '13px' }}>
                          <input
                            type="checkbox"
                            checked={formData.saleDiv.includes(division.value)}
                            onChange={(e) => {
                              const checked = e.target.checked;
                              const newSaleDiv = checked
                                ? [...formData.saleDiv, division.value]
                                : formData.saleDiv.filter(v => v !== division.value);
                              handleChange('saleDiv', newSaleDiv.length > 0 ? newSaleDiv : [division.value]);
                            }}
                            style={{ cursor: 'pointer' }}
                          />
                          <span>{division.label}</span>
                        </label>
                      ))}
                    </div>
                  </td>
                  <td style={{ padding: '2px 4px', width: '90px', fontWeight: '600', border: '1px solid #cbd5e1', background: '#f8fafc' }}>물건상태</td>
                  <td style={{ padding: '2px 4px', border: '1px solid #cbd5e1' }} colSpan="3">
                    <div style={{ display: 'flex', gap: '8px', flexWrap: 'wrap' }}>
                      {propertyStatuses.map((status) => (
                        <label key={status.value} style={{ display: 'flex', alignItems: 'center', gap: '4px', cursor: 'pointer', fontSize: '13px' }}>
                          <input
                            type="radio"
                            name="ptSts"
                            checked={formData.ptSts === status.value}
                            onChange={() => handleChange('ptSts', status.value)}
                            style={{ cursor: 'pointer' }}
                          />
                          <span>{status.label}</span>
                        </label>
                      ))}
                    </div>
                  </td>
                  <td style={{ padding: '2px 4px', width: '90px', fontWeight: '600', border: '1px solid #cbd5e1', background: '#f8fafc' }}>현상태</td>
                  <td style={{ padding: '2px 4px', border: '1px solid #cbd5e1' }}>
                    <select value={formData.currentStatus} onChange={(e) => handleChange('currentStatus', e.target.value)} style={{ width: '100%', padding: '2px 4px', fontSize: '13px', border: 'none' }}>
                      <option value="">선택</option>
                      <option value="주인거주">주인거주</option>
                      <option value="전세">전세</option>
                      <option value="공실">공실</option>
                      <option value="월세">월세</option>
                      <option value="기타임대">기타임대</option>
                    </select>
                  </td>
                </tr>

                {/* 공급면적 / 전용면적 / 대지면적 - 3개 */}
                <tr>
                  <td style={{ padding: '2px 4px', width: '90px', fontWeight: '600', border: '1px solid #cbd5e1', background: '#f8fafc' }}>공급면적(㎡)</td>
                  <td style={{ padding: '2px 4px', border: '1px solid #cbd5e1' }}>
                    <input type="number" step="0.01" value={formData.supArea} onChange={(e) => handleChange('supArea', e.target.value)} style={{ width: '100%', padding: '2px 4px', fontSize: '13px', border: 'none' }} />
                  </td>
                  <td style={{ padding: '2px 4px', width: '90px', fontWeight: '600', border: '1px solid #cbd5e1', background: '#f8fafc' }}>전용면적(㎡)</td>
                  <td style={{ padding: '2px 4px', border: '1px solid #cbd5e1' }}>
                    <input type="number" step="0.01" value={formData.excArea} onChange={(e) => handleChange('excArea', e.target.value)} style={{ width: '100%', padding: '2px 4px', fontSize: '13px', border: 'none' }} />
                  </td>
                  <td style={{ padding: '2px 4px', width: '90px', fontWeight: '600', border: '1px solid #cbd5e1', background: '#f8fafc' }}>대지면적(㎡)</td>
                  <td style={{ padding: '2px 4px', border: '1px solid #cbd5e1' }} colSpan="5">
                    <input type="number" step="0.01" value={formData.landShare} onChange={(e) => handleChange('landShare', e.target.value)} style={{ width: '100%', padding: '2px 4px', fontSize: '13px', border: 'none' }} />
                  </td>
                </tr>

                {/* 매매가 / 전세가 / 보증금 / 월임대료 / 기타비용 - 5개 (라벨+입력 = 10칸) */}
                <tr>
                  <td style={{ padding: '2px 4px', width: '90px', fontWeight: '600', border: '1px solid #cbd5e1', background: '#f8fafc' }}>매매가(만원)</td>
                  <td style={{ padding: '2px 4px', border: '1px solid #cbd5e1' }}>
                    <input type="number" value={formData.saleAmt} onChange={(e) => handleChange('saleAmt', e.target.value)} style={{ width: '100%', padding: '2px 4px', fontSize: '13px', border: 'none' }} />
                  </td>
                  <td style={{ padding: '2px 4px', width: '90px', fontWeight: '600', border: '1px solid #cbd5e1', background: '#f8fafc' }}>전세가(만원)</td>
                  <td style={{ padding: '2px 4px', border: '1px solid #cbd5e1' }}>
                    <input type="number" value={formData.lesAmt} onChange={(e) => handleChange('lesAmt', e.target.value)} style={{ width: '100%', padding: '2px 4px', fontSize: '13px', border: 'none' }} />
                  </td>
                  <td style={{ padding: '2px 4px', width: '90px', fontWeight: '600', border: '1px solid #cbd5e1', background: '#f8fafc' }}>보증금(만원)</td>
                  <td style={{ padding: '2px 4px', border: '1px solid #cbd5e1' }}>
                    <input type="number" value={formData.protAmt} onChange={(e) => handleChange('protAmt', e.target.value)} style={{ width: '100%', padding: '2px 4px', fontSize: '13px', border: 'none' }} />
                  </td>
                  <td style={{ padding: '2px 4px', width: '90px', fontWeight: '600', border: '1px solid #cbd5e1', background: '#f8fafc' }}>월임대료(만원)</td>
                  <td style={{ padding: '2px 4px', border: '1px solid #cbd5e1' }}>
                    <input type="number" value={formData.monAmt} onChange={(e) => handleChange('monAmt', e.target.value)} style={{ width: '100%', padding: '2px 4px', fontSize: '13px', border: 'none' }} />
                  </td>
                  <td style={{ padding: '2px 4px', width: '90px', fontWeight: '600', border: '1px solid #cbd5e1', background: '#f8fafc' }}>기타비용(만원)</td>
                  <td style={{ padding: '2px 4px', border: '1px solid #cbd5e1' }}>
                    <input type="number" value={formData.etcAmt} onChange={(e) => handleChange('etcAmt', e.target.value)} style={{ width: '100%', padding: '2px 4px', fontSize: '13px', border: 'none' }} />
                  </td>
                </tr>

                {/* 권리금 / 현보증금 / 현월세 / 융자금 / 잔금후융자금 - 5개 (라벨+입력 = 10칸) */}
                <tr>
                  <td style={{ padding: '2px 4px', width: '90px', fontWeight: '600', border: '1px solid #cbd5e1', background: '#f8fafc' }}>권리금(만원)</td>
                  <td style={{ padding: '2px 4px', border: '1px solid #cbd5e1' }}>
                    <input type="number" value={formData.layAmt} onChange={(e) => handleChange('layAmt', e.target.value)} style={{ width: '100%', padding: '2px 4px', fontSize: '13px', border: 'none' }} />
                  </td>
                  <td style={{ padding: '2px 4px', width: '90px', fontWeight: '600', border: '1px solid #cbd5e1', background: '#f8fafc' }}>현보증금(만원)</td>
                  <td style={{ padding: '2px 4px', border: '1px solid #cbd5e1' }}>
                    <input type="number" value={formData.nowDepAmt} onChange={(e) => handleChange('nowDepAmt', e.target.value)} style={{ width: '100%', padding: '2px 4px', fontSize: '13px', border: 'none' }} />
                  </td>
                  <td style={{ padding: '2px 4px', width: '90px', fontWeight: '600', border: '1px solid #cbd5e1', background: '#f8fafc' }}>현월세(만원)</td>
                  <td style={{ padding: '2px 4px', border: '1px solid #cbd5e1' }}>
                    <input type="number" value={formData.nowMonAmt} onChange={(e) => handleChange('nowMonAmt', e.target.value)} style={{ width: '100%', padding: '2px 4px', fontSize: '13px', border: 'none' }} />
                  </td>
                  <td style={{ padding: '2px 4px', width: '90px', fontWeight: '600', border: '1px solid #cbd5e1', background: '#f8fafc' }}>융자금(만원)</td>
                  <td style={{ padding: '2px 4px', border: '1px solid #cbd5e1' }}>
                    <input type="number" value={formData.loanAmt} onChange={(e) => handleChange('loanAmt', e.target.value)} style={{ width: '100%', padding: '2px 4px', fontSize: '13px', border: 'none' }} />
                  </td>
                  <td style={{ padding: '2px 4px', width: '90px', fontWeight: '600', border: '1px solid #cbd5e1', background: '#f8fafc' }}>잔금후융자금(만원)</td>
                  <td style={{ padding: '2px 4px', border: '1px solid #cbd5e1' }}>
                    <input type="number" value={formData.loanAmtAft} onChange={(e) => handleChange('loanAmtAft', e.target.value)} style={{ width: '100%', padding: '2px 4px', fontSize: '13px', border: 'none' }} />
                  </td>
                </tr>

                {/* 관리비 / 관리비 내역 / 만기일 / 잔금예정일 / 잔금일자 - 5개 (라벨+입력 = 10칸) */}
                <tr>
                  <td style={{ padding: '2px 4px', width: '90px', fontWeight: '600', border: '1px solid #cbd5e1', background: '#f8fafc' }}>관리비(만원)</td>
                  <td style={{ padding: '2px 4px', border: '1px solid #cbd5e1' }}>
                    <input type="number" value={formData.maintCost} onChange={(e) => handleChange('maintCost', e.target.value)} style={{ width: '100%', padding: '2px 4px', fontSize: '13px', border: 'none' }} />
                  </td>
                  <td style={{ padding: '2px 4px', width: '90px', fontWeight: '600', border: '1px solid #cbd5e1', background: '#f8fafc' }}>관리비 내역</td>
                  <td style={{ padding: '2px 4px', border: '1px solid #cbd5e1' }}>
                    <input type="text" value={formData.maintDtl} onChange={(e) => handleChange('maintDtl', e.target.value)} placeholder="관리비, 주차비 포함" style={{ width: '100%', padding: '2px 4px', fontSize: '13px', border: 'none' }} />
                  </td>
                  <td style={{ padding: '2px 4px', width: '90px', fontWeight: '600', border: '1px solid #cbd5e1', background: '#f8fafc' }}>만기일</td>
                  <td style={{ padding: '2px 4px', border: '1px solid #cbd5e1' }}>
                    <input type="date" value={formData.mtryDate} onChange={(e) => handleChange('mtryDate', e.target.value)} style={{ width: '100%', padding: '2px 4px', fontSize: '13px', border: 'none' }} />
                  </td>
                  <td style={{ padding: '2px 4px', width: '90px', fontWeight: '600', border: '1px solid #cbd5e1', background: '#f8fafc' }}>잔금예정일</td>
                  <td style={{ padding: '2px 4px', border: '1px solid #cbd5e1' }}>
                    <input type="date" value={formData.exptDate} onChange={(e) => handleChange('exptDate', e.target.value)} style={{ width: '100%', padding: '2px 4px', fontSize: '13px', border: 'none' }} />
                  </td>
                  <td style={{ padding: '2px 4px', width: '90px', fontWeight: '600', border: '1px solid #cbd5e1', background: '#f8fafc' }}>잔금일자</td>
                  <td style={{ padding: '2px 4px', border: '1px solid #cbd5e1' }}>
                    <input type="date" value={formData.balDate} onChange={(e) => handleChange('balDate', e.target.value)} style={{ width: '100%', padding: '2px 4px', fontSize: '13px', border: 'none' }} />
                  </td>
                </tr>

                {/* 분양가 - 임시 필드 추가 (formData에 없으면 제거 가능) */}
                {/* <tr>
                  <td style={{ padding: '4px 6px', fontWeight: '600', border: '1px solid #cbd5e1', background: '#f8fafc' }}>분양가(만원)</td>
                  <td style={{ padding: '2px 4px', border: '1px solid #cbd5e1' }} colSpan="3">
                    <input type="number" style={{ width: '100%', padding: '2px 4px', fontSize: '13px', border: 'none' }} />
                  </td>
                </tr> */}

                {/* 해당층 / 탑층 / 방개수 / 욕실개수 / 세대수 - 5개 */}
                <tr>
                  <td style={{ padding: '2px 4px', width: '90px', fontWeight: '600', border: '1px solid #cbd5e1', background: '#f8fafc' }}>해당층</td>
                  <td style={{ padding: '2px 4px', border: '1px solid #cbd5e1' }}>
                    <input type="number" value={formData.floor1} onChange={(e) => handleChange('floor1', e.target.value)} style={{ width: '100%', padding: '2px 4px', fontSize: '13px', border: 'none' }} />
                  </td>
                  <td style={{ padding: '2px 4px', width: '90px', fontWeight: '600', border: '1px solid #cbd5e1', background: '#f8fafc' }}>탑층</td>
                  <td style={{ padding: '2px 4px', border: '1px solid #cbd5e1' }}>
                    <input type="number" value={formData.floor2} onChange={(e) => handleChange('floor2', e.target.value)} style={{ width: '100%', padding: '2px 4px', fontSize: '13px', border: 'none' }} />
                  </td>
                  <td style={{ padding: '2px 4px', width: '90px', fontWeight: '600', border: '1px solid #cbd5e1', background: '#f8fafc' }}>방개수</td>
                  <td style={{ padding: '2px 4px', border: '1px solid #cbd5e1' }}>
                    <input type="number" value={formData.roomCnt} onChange={(e) => handleChange('roomCnt', e.target.value)} style={{ width: '100%', padding: '2px 4px', fontSize: '13px', border: 'none' }} />
                  </td>
                  <td style={{ padding: '2px 4px', width: '90px', fontWeight: '600', border: '1px solid #cbd5e1', background: '#f8fafc' }}>욕실개수</td>
                  <td style={{ padding: '2px 4px', border: '1px solid #cbd5e1' }}>
                    <input type="number" value={formData.bathCnt} onChange={(e) => handleChange('bathCnt', e.target.value)} style={{ width: '100%', padding: '2px 4px', fontSize: '13px', border: 'none' }} />
                  </td>
                  <td style={{ padding: '2px 4px', width: '90px', fontWeight: '600', border: '1px solid #cbd5e1', background: '#f8fafc' }}>세대수</td>
                  <td style={{ padding: '2px 4px', border: '1px solid #cbd5e1' }}>
                    <input type="number" value={formData.houseCnt} onChange={(e) => handleChange('houseCnt', e.target.value)} style={{ width: '100%', padding: '2px 4px', fontSize: '13px', border: 'none' }} />
                  </td>
                </tr>

                {/* 주차대수 / 방향 / 난방방식 / 난방연료 / 건물구조 - 5개 */}
                <tr>
                  <td style={{ padding: '2px 4px', width: '90px', fontWeight: '600', border: '1px solid #cbd5e1', background: '#f8fafc' }}>주차대수</td>
                  <td style={{ padding: '2px 4px', border: '1px solid #cbd5e1' }}>
                    <input type="number" step="0.1" value={formData.pkCnt} onChange={(e) => handleChange('pkCnt', e.target.value)} style={{ width: '100%', padding: '2px 4px', fontSize: '13px', border: 'none' }} placeholder="0.5" />
                  </td>
                  <td style={{ padding: '2px 4px', width: '90px', fontWeight: '600', border: '1px solid #cbd5e1', background: '#f8fafc' }}>방향</td>
                  <td style={{ padding: '2px 4px', border: '1px solid #cbd5e1' }}>
                    <select value={formData.dirStd} onChange={(e) => handleChange('dirStd', e.target.value)} style={{ width: '100%', padding: '2px 4px', fontSize: '13px', border: 'none' }}>
                      <option value="">선택</option>
                      <option value="남향">남향</option>
                      <option value="동향">동향</option>
                      <option value="서향">서향</option>
                      <option value="북향">북향</option>
                      <option value="남동향">남동향</option>
                      <option value="남서향">남서향</option>
                      <option value="북동향">북동향</option>
                      <option value="북서향">북서향</option>
                    </select>
                  </td>
                  <td style={{ padding: '2px 4px', width: '90px', fontWeight: '600', border: '1px solid #cbd5e1', background: '#f8fafc' }}>난방방식</td>
                  <td style={{ padding: '2px 4px', border: '1px solid #cbd5e1' }}>
                    <select value={formData.heatMethod} onChange={(e) => handleChange('heatMethod', e.target.value)} style={{ width: '100%', padding: '2px 4px', fontSize: '13px', border: 'none' }}>
                      <option value="">선택</option>
                      <option value="개별난방">개별난방</option>
                      <option value="중앙난방">중앙난방</option>
                      <option value="지역난방">지역난방</option>
                    </select>
                  </td>
                  <td style={{ padding: '2px 4px', width: '90px', fontWeight: '600', border: '1px solid #cbd5e1', background: '#f8fafc' }}>난방연료</td>
                  <td style={{ padding: '2px 4px', border: '1px solid #cbd5e1' }}>
                    <select value={formData.heatFuel} onChange={(e) => handleChange('heatFuel', e.target.value)} style={{ width: '100%', padding: '2px 4px', fontSize: '13px', border: 'none' }}>
                      <option value="">선택</option>
                      <option value="도시가스">도시가스</option>
                      <option value="기름">기름</option>
                      <option value="전기">전기</option>
                      <option value="심야전기">심야전기</option>
                    </select>
                  </td>
                  <td style={{ padding: '2px 4px', width: '90px', fontWeight: '600', border: '1px solid #cbd5e1', background: '#f8fafc' }}>건물구조</td>
                  <td style={{ padding: '2px 4px', border: '1px solid #cbd5e1' }}>
                    <select value={formData.buidStruct} onChange={(e) => handleChange('buidStruct', e.target.value)} style={{ width: '100%', padding: '2px 4px', fontSize: '13px', border: 'none' }}>
                      <option value="">선택</option>
                      <option value="철근콘크리트">철근콘크리트</option>
                      <option value="철골">철골</option>
                      <option value="철골콘크리트">철골콘크리트</option>
                      <option value="벽돌">벽돌</option>
                      <option value="기타">기타</option>
                    </select>
                  </td>
                </tr>

                {/* 발코니확장 / 출입구조 / 사용승인일 / 옵션 - 아파트/오피스텔/분양권/재건축/재개발에만 옵션 표시 */}
                <tr>
                  <td style={{ padding: '2px 4px', width: '90px', fontWeight: '600', border: '1px solid #cbd5e1', background: '#f8fafc' }}>발코니확장</td>
                  <td style={{ padding: '2px 4px', border: '1px solid #cbd5e1' }}>
                    <select value={formData.balcExt} onChange={(e) => handleChange('balcExt', e.target.value)} style={{ width: '100%', padding: '2px 4px', fontSize: '13px', border: 'none' }}>
                      <option value="">선택</option>
                      <option value="Y">확장</option>
                      <option value="N">미확장</option>
                    </select>
                  </td>
                  <td style={{ padding: '2px 4px', width: '90px', fontWeight: '600', border: '1px solid #cbd5e1', background: '#f8fafc' }}>출입구조</td>
                  <td style={{ padding: '2px 4px', border: '1px solid #cbd5e1' }}>
                    <select value={formData.entrStruct} onChange={(e) => handleChange('entrStruct', e.target.value)} style={{ width: '100%', padding: '2px 4px', fontSize: '13px', border: 'none' }}>
                      <option value="">선택</option>
                      <option value="계단식">계단식</option>
                      <option value="복도식">복도식</option>
                      <option value="복합식">복합식</option>
                    </select>
                  </td>
                  <td style={{ padding: '2px 4px', width: '90px', fontWeight: '600', border: '1px solid #cbd5e1', background: '#f8fafc' }}>사용승인일</td>
                  <td style={{ padding: '2px 4px', border: '1px solid #cbd5e1' }}>
                    <input
                      type="date"
                      value={formData.compYear && formData.compYear.length === 8 ? `${formData.compYear.slice(0,4)}-${formData.compYear.slice(4,6)}-${formData.compYear.slice(6,8)}` : ''}
                      onChange={(e) => handleChange('compYear', e.target.value.replace(/-/g, ''))}
                      style={{ width: '100%', padding: '2px 4px', fontSize: '13px', border: 'none' }}
                    />
                  </td>
                  {['SYCA101', 'SYCA102', 'SYCA105', 'SYCA106', 'SYCA107', 'SYCA104', 'SYCA120'].includes(formData.ptType) ? (
                    <>
                      <td style={{ padding: '2px 4px', width: '90px', fontWeight: '600', border: '1px solid #cbd5e1', background: '#f8fafc' }}>옵션</td>
                      <td style={{ padding: '2px 4px', border: '1px solid #cbd5e1' }} colSpan="3">
                        <input
                          type="text"
                          value={formData.opt}
                          onClick={() => setShowOptionModal(true)}
                          readOnly
                          placeholder="클릭하여 옵션 선택"
                          style={{ width: '100%', padding: '2px 4px', fontSize: '13px', border: 'none', cursor: 'pointer', background: '#fafafa' }}
                        />
                      </td>
                    </>
                  ) : (
                    <td style={{ padding: '2px 4px', border: '1px solid #cbd5e1' }} colSpan="4"></td>
                  )}
                </tr>

                {/* 건축물용도 / 기타제한사항 / 계약갱신청구권 / 주택임대사업자 - 토지가 아니고 아파트/오피스텔/분양권/재건축/재개발이 아닌 경우 */}
                {formData.ptType !== 'SYCA115' && !['SYCA101', 'SYCA102', 'SYCA105', 'SYCA106', 'SYCA107', 'SYCA104', 'SYCA120'].includes(formData.ptType) && (
                  <tr>
                    <td style={{ padding: '2px 4px', width: '90px', fontWeight: '600', border: '1px solid #cbd5e1', background: '#f8fafc' }}>건축물용도</td>
                    <td style={{ padding: '2px 4px', border: '1px solid #cbd5e1' }}>
                      <select value={formData.buildingUse} onChange={(e) => handleChange('buildingUse', e.target.value)} style={{ width: '100%', padding: '2px 4px', fontSize: '13px', border: 'none' }}>
                        <option value="">선택</option>
