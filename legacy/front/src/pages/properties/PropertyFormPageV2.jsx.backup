                <p style={{ fontSize: '14px' }}>첨부파일 기능은 준비 중입니다.</p>
              </div>
            </div>
          )}

        </div>

        {/* 푸터 버튼 */}
        {activeTab === 'property' && (
        <div className="page-footer">
        <button
          type="button"
          onClick={async () => {
            if (editData && editData.ptNo) {
              // Electron API를 통해 별도 창으로 열기
              if (window.electronAPI?.modal) {
                try {
                  await window.electronAPI.modal.open({
                    type: 'hub-form',
                    data: {
                      title: '거래정보 등록',
                      tradeDiv: 'PT',
                      propertyData: formData,
                      ptNo: editData.ptNo,
                    },
                    width: 1200,
                    height: 800,
                  });
                } catch (error) {
                  console.error('거래정보 등록 창 열기 실패:', error);
                  // fallback to modal
                  openWithProperty(editData);
                }
              } else {
                // Electron API 없으면 기존 방식 사용
                openWithProperty(editData);
              }
            } else {
              toast.error('저장된 물건 정보만 정보망 전송이 가능합니다.');
            }
          }}
          className="px-4 py-2 text-sm font-medium text-white bg-sky-500 rounded-md hover:bg-sky-600"
        >
          정보망전송
        </button>
        <div className="flex gap-3">
          <button
            type="button"
            onClick={onClose}
            className="px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50"
          >
            취소
          </button>
          <button
            type="submit"
            disabled={loading}
            onClick={handleSubmit}
            className="px-4 py-2 text-sm font-medium text-white bg-indigo-600 rounded-md hover:bg-indigo-700 disabled:opacity-50"
          >
            {loading ? '저장 중...' : (editData ? '수정' : '등록')}
          </button>
        </div>
        </div>
        )}
      </form>

      <style>{`
        .property-form-page {
          height: 100vh;
          display: flex;
          flex-direction: column;
          background-color: #f9fafb;
        }

        .page-header {
          display: flex;
          align-items: center;
          justify-content: space-between;
          padding: 0.5rem 1rem;
          background-color: white;
          border-bottom: 1px solid #e5e7eb;
          flex-shrink: 0;
        }

        .page-title {
          font-size: 1.125rem;
          font-weight: 600;
          color: #111827;
        }

        .close-btn {
          padding: 0.5rem;
          border-radius: 0.375rem;
          border: none;
          background: none;
          cursor: pointer;
          color: #6b7280;
          transition: all 0.2s;
        }

        .close-btn:hover {
          background-color: #f3f4f6;
          color: #111827;
        }

        .page-form {
          flex: 1;
          display: flex;
          flex-direction: column;
          overflow: hidden;
        }

        .form-content {
          flex: 1;
          overflow-y: auto;
          padding: 1.5rem;
        }

        .page-footer {
          display: flex;
          align-items: center;
          justify-content: space-between;
          padding: 1rem 1.5rem;
          background-color: white;
          border-top: 1px solid #e5e7eb;
          flex-shrink: 0;
        }

}
        @keyframes pulse-slow {
          0%, 100% {
            box-shadow: 0 2px 4px rgba(99, 102, 241, 0.4);
          }
          50% {
            box-shadow: 0 4px 12px rgba(99, 102, 241, 0.8);
          }
        }

        .animate-pulse-slow {
          animation: pulse-slow 2s ease-in-out infinite;
        }

        .animate-pulse-slow:hover {
          animation: none;
        }

        @keyframes slideDown {
          from {
            opacity: 0;
            transform: translateY(-10px);
          }
          to {
            opacity: 1;
            transform: translateY(0);
          }
        }

        .animate-slideDown {
          animation: slideDown 0.3s ease-out;
        }
      `}</style>

      {/* 옵션 선택 모달 */}
      <OptionModal
        isOpen={showOptionModal}
        onClose={() => setShowOptionModal(false)}
        initialValue={formData.opt}
        onConfirm={(value) => handleChange('opt', value)}
      />

    </div>
  );
};

export default PropertyFormPage;
